# Abandoned lead recovery (new)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Anon-nyckel — krävs för att POST:a till Supabase Edge Functions (track-widget-event)
SUPABASE_ANON_KEY=eyJ...
RESEND_API_KEY=re_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+46...
CRON_SECRET=random-secret-string
WIDGET_BASE_URL=https://widgetsell.se

# Fortnox fakturering
# 1. Registrera en integration på developer.fortnox.se → få Client ID + Client Secret
# 2. Besök https://widgetsell.se/api/fortnox/auth för att koppla ditt konto och få refresh token
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REFRESH_TOKEN=

# Skyddar /api/clients och /api/cron/invoice-monthly
BILLING_SECRET=random-secret-string
LOVABLE_WEBHOOK_URL=https://syvapmdohgugdrpoanqh.supabase.co/functions/v1/widgetsell-booking-webhook

# Månadsrapporter → Lovable-integration
# Lovable tar emot den färdiga rapporten och hanterar portal, e-post och lagring.
# Sätt till Lovable:s Supabase Edge Function URL för rapport-webhooket.
LOVABLE_REPORT_WEBHOOK_URL=https://syvapmdohgugdrpoanqh.supabase.co/functions/v1/widgetsell-report-webhook
# Delad hemlighet — sätt samma värde i Lovable Edge Function (WIDGETSELL_REPORT_SECRET)
LOVABLE_REPORT_SECRET=generera-ett-långt-slumpmässigt-värde

# Fallback-e-post (används bara om LOVABLE_REPORT_WEBHOOK_URL ej är satt)
RESEND_API_KEY=re_...
REPORT_FROM_EMAIL=rapport@widgetsell.se
